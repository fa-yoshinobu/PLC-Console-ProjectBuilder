<Window x:Class="PlcIoCheckerQr.Wpf.Windows.PastePreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paste preview"
        Width="860"
        Height="560"
        MinWidth="640"
        MinHeight="400"
        Icon="/icon.ico"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextMain}">

  <Window.Resources>
    <!-- Semantic colours live in App.xaml; this window only consumes them. -->

    <!-- Status badge shown in the Status column -->
    <DataTemplate x:Key="StatusCellTemplate">
      <Border x:Name="Badge"
              CornerRadius="10"
              Padding="10,3"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="{StaticResource SuccessBg}">
        <TextBlock x:Name="BadgeText"
                   Text="{Binding Status}"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource SuccessFg}"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="error">
          <Setter TargetName="Badge" Property="Background" Value="{StaticResource ErrorBg}"/>
          <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource ErrorFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="skip">
          <Setter TargetName="Badge" Property="Background" Value="{StaticResource NeutralBg}"/>
          <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource NeutralFg}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="LineCellTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ErrorCellTextStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource ErrorFg}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,6"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0"
            Background="{StaticResource HeaderBg}"
            BorderBrush="{StaticResource BorderSoft}"
            BorderThickness="0,0,0,1"
            Padding="20,14">
      <StackPanel>
        <TextBlock x:Name="TitleTextBlock" Style="{StaticResource SectionTitle}"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Border Background="{StaticResource SuccessBg}" CornerRadius="10" Padding="10,3" Margin="0,0,8,0">
            <TextBlock x:Name="OkCountText"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource SuccessFg}"/>
          </Border>
          <Border Background="{StaticResource ErrorBg}" CornerRadius="10" Padding="10,3" Margin="0,0,8,0">
            <TextBlock x:Name="ErrorCountText"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ErrorFg}"/>
          </Border>
          <Border Background="{StaticResource NeutralBg}" CornerRadius="10" Padding="10,3">
            <TextBlock x:Name="SkipCountText"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource NeutralFg}"/>
          </Border>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Preview rows -->
    <DataGrid x:Name="PreviewGrid"
              Grid.Row="1"
              Margin="20,14"
              IsReadOnly="True"
              CanUserAddRows="False"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              RowHeaderWidth="0"
              RowHeight="NaN"
              MinRowHeight="36">
      <DataGrid.RowStyle>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="error">
              <Setter Property="Background" Value="{StaticResource ErrorRowBg}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="skip">
              <Setter Property="Background" Value="{StaticResource NeutralRowBg}"/>
              <Setter Property="Foreground" Value="{StaticResource NeutralFg}"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </DataGrid.RowStyle>
    </DataGrid>

    <!-- Footer -->
    <Border Grid.Row="2"
            Background="{StaticResource HeaderBg}"
            BorderBrush="{StaticResource BorderSoft}"
            BorderThickness="0,1,0,0"
            Padding="20,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="HintTextBlock"
                   Style="{StaticResource SectionMeta}"
                   VerticalAlignment="Center"
                   Margin="0,0,16,0"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="CancelButton"
                  Style="{StaticResource AppButton}"
                  IsCancel="True"
                  Margin="0,0,10,0"
                  Click="Cancel_Click"/>
          <Button x:Name="ImportButton"
                  Style="{StaticResource PrimaryButton}"
                  IsDefault="True"
                  Click="Import_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
